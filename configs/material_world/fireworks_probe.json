{
  "version": "material_world_fireworks_probe_v0",
  "description": "Probe configuration for Fireworks/Qwen material-world synthetic data generation.",
  "notes": [
    "In this v0 probe, metadata.material means the material the object is made of.",
    "A useful later extension would deliberately vary the surface/contact material while holding the object material fixed, such as a glass cup on tile vs wood vs carpet."
  ],
  "model_id": "accounts/fireworks/models/qwen3p6-plus",
  "fireworks_url": "https://api.fireworks.ai/inference/v1/chat/completions",
  "reasoning_effort": "none",
  "reasoning_history": "disabled",
  "material_classes_path": "configs/material_world/material_classes.json",
  "material_objects_path": "configs/material_world/material_objects.json",
  "coverage_sets_path": "configs/material_world/coverage_sets.json",
  "audit_config_path": "configs/material_world/audit_config.json",
  "output_dir": "data/material_world/fireworks_probe_v0",
  "material_class_limit": 4,
  "object_limit": 3,
  "style_limit": 4,
  "scenario_limit": 12,
  "object_sampling": {
    "mode": "model_choice",
    "scope": "selected_objects"
  },
  "audit_edit_limit": 20,
  "batching": {
    "scenario_plans_per_request": 4,
    "render_examples_per_request": 4,
    "check_examples_per_request": 4,
    "audit_edit_examples_per_request": 1
  },
  "request": {
    "timeout_seconds": 600,
    "max_request_retries": 4,
    "initial_backoff_seconds": 1.0,
    "max_backoff_seconds": 16.0
  },
  "stages": {
    "scenario_plans": {
      "temperature": 0.3,
      "max_tokens": 8000
    },
    "prose_render": {
      "temperature": 0.6,
      "max_tokens": 4500
    },
    "check_edit": {
      "temperature": 0.2,
      "max_tokens": 4500
    },
    "audit_edit": {
      "temperature": 0.25,
      "max_tokens": 900
    }
  }
}
