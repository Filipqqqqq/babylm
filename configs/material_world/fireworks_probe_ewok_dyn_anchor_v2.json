{
  "version": "material_world_fireworks_probe_anchor_v2",
  "description": "Fireworks/Qwen generation config for an anchor-guided material-dynamics top-up.",
  "notes": [
    "This config is intended to be mixed with the previous fireworks_probe_ewok_softmix_1000_dyn corpus.",
    "It is anchor-guided through the coverage set prompt and should be followed by the EWoK material coverage audit before training.",
    "The planner quota-assigns lexical anchors round-robin through target_anchor, then the audit checks whether the final text retained them."
  ],
  "model_id": "accounts/fireworks/models/qwen3p6-plus",
  "fireworks_url": "https://api.fireworks.ai/inference/v1/chat/completions",
  "reasoning_effort": "none",
  "reasoning_history": "disabled",
  "material_classes_path": "configs/material_world/material_classes.json",
  "material_objects_path": "configs/material_world/material_objects.json",
  "coverage_sets_path": "configs/material_world/coverage_sets_anchor_v2.json",
  "audit_config_path": "configs/material_world/audit_config.json",
  "output_dir": "data/material_world/fireworks_probe_ewok_dyn_anchor_v2",
  "coverage_set_ids": ["ewok_material_dynamics_anchor_v2"],
  "coverage_mix": {
    "ewok_material_dynamics_anchor_v2": {
      "dynamic_fraction": 0.70,
      "anchor_fraction": 1.00
    }
  },
  "selection_seed": "mw-dyn-anchor-v2",
  "material_class_limit": 13,
  "object_limit": 32,
  "style_limit": 4,
  "scenario_limit": 500,
  "object_sampling": {
    "mode": "balanced_round_robin",
    "scope": "selected_objects"
  },
  "style_sampling": {
    "mode": "balanced_round_robin",
    "scope": "selected_styles"
  },
  "audit_edit_limit": 120,
  "batching": {
    "scenario_plans_per_request": 10,
    "render_examples_per_request": 10,
    "check_examples_per_request": 10,
    "audit_edit_examples_per_request": 2
  },
  "request": {
    "timeout_seconds": 600,
    "max_request_retries": 4,
    "initial_backoff_seconds": 1.0,
    "max_backoff_seconds": 16.0
  },
  "stages": {
    "scenario_plans": {
      "temperature": 0.3,
      "max_tokens": 9000
    },
    "prose_render": {
      "temperature": 0.6,
      "max_tokens": 5000
    },
    "check_edit": {
      "temperature": 0.2,
      "max_tokens": 5000
    },
    "audit_edit": {
      "temperature": 0.25,
      "max_tokens": 1200
    }
  }
}
