{
  "version": "material_world_audit_v0",
  "description": "Lightweight quality and diversity audit thresholds for material-world synthetic prose.",
  "openings": {
    "min_corpus_examples_for_rate_flags": 25,
    "first_5_warning_rate": 0.03,
    "first_8_warning_rate": 0.02,
    "hard_rate": 0.05,
    "min_group_count": 2,
    "watched_prefixes": [
      "when the",
      "as the",
      "this is different",
      "unlike a",
      "because the",
      "the object",
      "the material"
    ]
  },
  "connectives": {
    "phrases": [
      "because",
      "so",
      "therefore",
      "this is different from",
      "unlike",
      "instead of",
      "rather than",
      "while",
      "showing how",
      "as a result",
      "which means",
      "due to",
      "compared with",
      "in contrast"
    ],
    "because_example_rate_warning": 0.25,
    "contrast_phrases": ["unlike", "instead of", "this is different from", "rather than"],
    "contrast_combined_example_rate_warning": 0.4,
    "per_example_marker_warning_count": 3
  },
  "styles": {
    "min_corpus_examples_for_balance_warnings": 25,
    "aliases": {
      "repair_craft_note": "repair_or_craft_note",
      "application_tradeoff_paragraph": "application_tradeoff",
      "simple_encyclopedia_paragraph": "simple_encyclopedia"
    },
    "targets": {
      "everyday_narrative": 0.2,
      "comparison_paragraph": 0.2,
      "child_science_explanation": 0.15,
      "repair_or_craft_note": 0.15,
      "observation_log": 0.1,
      "short_dialogue": 0.1,
      "application_tradeoff": 0.05,
      "simple_encyclopedia": 0.05
    },
    "target_tolerance_points": 0.07,
    "min_rate_warning": 0.03,
    "max_rate_warning": 0.3
  },
  "negative_reporting": {
    "phrases": [
      "not",
      "no",
      "never",
      "does not",
      "doesn't",
      "did not",
      "didn't",
      "cannot",
      "can't",
      "unlike",
      "instead of",
      "rather than",
      "without",
      "but not"
    ],
    "target_min_rate": 0.2,
    "target_max_rate": 0.3,
    "warning_min_rate": 0.15,
    "warning_max_rate": 0.4
  },
  "lengths": {
    "buckets": {
      "short_64": [35, 60],
      "medium_128": [70, 120],
      "long_256": [140, 220],
      "xlong_512": [280, 420]
    },
    "target_rates": {
      "short_64": [0.1, 0.2],
      "medium_128": [0.45, 0.6],
      "long_256": [0.2, 0.35],
      "xlong_512": [0.0, 0.1]
    },
    "single_bucket_warning_rate": 0.7,
    "too_short_words": 30,
    "too_long_words": 450,
    "style_length_variance_min_examples": 10,
    "style_length_std_warning": 8.0
  },
  "dedupe": {
    "jaccard_warning_threshold": 0.8,
    "jaccard_hard_drop_threshold": 0.9,
    "min_words_for_jaccard": 8,
    "max_examples_for_all_pairs": 5000,
    "length_ratio_min": 0.65,
    "repeated_first_12_warning_count": 2,
    "repeated_first_12_hard_count": 5,
    "eight_gram_warning_count": 3
  },
  "collapse": {
    "min_examples_per_material": 20,
    "dominant_dynamic_rate_warning": 0.55
  },
  "template_phrases": {
    "phrases": [
      "made of",
      "this shows",
      "this demonstrates",
      "the material",
      "the object",
      "in conclusion",
      "the dynamics",
      "structural integrity",
      "physical properties",
      "absorbed the shock",
      "cracked or shattered into sharp pieces",
      "stayed whole",
      "kept its shape"
    ],
    "phrase_rate_warning": 0.15,
    "top_ngram_n": 4,
    "top_ngram_limit": 25
  }
}
