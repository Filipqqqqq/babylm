  "discourse_styles": [
    {
      "style_id": "everyday_observation",
      "style_name": "Child everyday noticing",
      "description": "A small everyday moment from the perspective of a child noticing what changed.",
      "guidance": [
        "Write like a child or nearby adult noticed one concrete event during ordinary play, cleanup, cooking, or classroom activity.",
        "Use simple sensory details and natural curiosity, not a lab-report voice.",
        "Keep the cause and result visible, but do not explain the hidden schema.",
        "Use active event wording, such as the object fell, rose, sped up, slowed down, rolled, or slid."
      ]
    },
    {
      "style_id": "cause_effect_explanation",
      "style_name": "Short simple wiki",
      "description": "A plain encyclopedia-like explanation of one physical dynamic, with the scenario as the central example.",
      "guidance": [
        "Start with the dynamic idea or process, then use the scenario as the central example.",
        "Use clear general prose, like a short simple wiki entry for children.",
        "Keep the paragraph informative without sounding like a quiz answer or metadata explanation.",
        "Make the central example an active physical event, not a passive label for a scene."
      ]
    },
    {
      "style_id": "comparison_contrast",
      "style_name": "Practical handling contrast",
      "description": "A practical note about making, preventing, or diagnosing a physical change.",
      "guidance": [
        "Write from the perspective of someone handling the object, arranging the setup, or trying to prevent the contrast outcome.",
        "Mention the contrast process only to clarify what would have happened under a different condition.",
        "Keep the expected process more central than the contrast.",
        "Describe what the object or person actively did before discussing the contrast."
      ]
    },
    {
      "style_id": "observation_log",
      "style_name": "Compact observation record",
      "description": "A brief field-note-style record of one visible physical event.",
      "guidance": [
        "Use a compact note style, but avoid repeated labels like Cause, Process, and Outcome.",
        "Let the order of noticed details carry the before clue, motion, and result.",
        "Vary sentence shape from other records in the same batch.",
        "Include one direct event sentence with the object or person as subject."
      ]
    }
  ],
