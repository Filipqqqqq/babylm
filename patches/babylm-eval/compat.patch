diff --git a/strict/evaluation_pipeline/hf_loading.py b/strict/evaluation_pipeline/hf_loading.py
new file mode 100644
index 0000000..2d66e59
--- /dev/null
+++ b/strict/evaluation_pipeline/hf_loading.py
@@ -0,0 +1,13 @@
+from transformers import AutoProcessor, AutoTokenizer
+
+
+def load_processor_or_tokenizer(model_path_or_name: str, **kwargs):
+    try:
+        return AutoProcessor.from_pretrained(model_path_or_name, **kwargs)
+    except ValueError as processor_error:
+        try:
+            return AutoTokenizer.from_pretrained(model_path_or_name, **kwargs)
+        except Exception as tokenizer_error:
+            raise ValueError(
+                f"Could not load a processor or tokenizer for {model_path_or_name!r}."
+            ) from tokenizer_error
